const groups = [
  {
    id: "standalone",
    title: "The Collection",
    subtitle: "Mods you can install on their own.",
    mods: mods.filter((mod) => !mod.series),
  },
  {
    id: "farm-and-charm",
    title: "Farm & Charm Series",
    subtitle: "Farm & Charm and the mods that build on it. The add-ons require Farm & Charm.",
    mods: [
      ...mods.filter((mod) => mod.title === "Farm & Charm"),
      ...mods.filter((mod) => mod.series === "farm-and-charm" && mod.title !== "Farm & Charm"),
    ],
  },
  {
    id: "lilis",
    title: "Lili's Series",
    subtitle: "A series made with extra love for MissLilitu.",
    mods: mods.filter((mod) => mod.series === "lilis"),
  },
];
---

<SiteLayout title="Mods">
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/icons/hero_mods.webp" />
  </Fragment>
    <NavBar />

  <main class="page">
    <section class="section sectionCentered">
      <div class="aboutHero modsHero">
        <div class="aboutHeroBackground modsHeroBackground"></div>
        <h1>Mods</h1>
      </div>
    </section>

    <section class="section sectionCentered sectionTight">
      <div class="sectionTitle">
        <span>Browse the Collection</span>
      </div>

      <p class="sectionSubtitle">Search by name, theme, or feature.</p>

      <div class="modsSearch">
        <input
          id="modsSearchInput"
          class="modsSearchInput"
          type="search"
          placeholder="Search mods..."
          autocomplete="off"
          spellcheck="false"
        />
        <div id="modsSearchMeta" class="modsSearchMeta"></div>
      </div>

      {groups.map((group) => (
        <div class="modsGroup" data-group={group.id}>
          <div class="sectionTitle modsGroupTitle">
            <span>{group.title}</span>
          </div>
          <p class="sectionSubtitle">{group.subtitle}</p>

          <div class="gridWrapper">
            <div class:list={["grid", { modsGridSeries: group.id === "farm-and-charm", modsGridCentered: group.id === "lilis" }]}>
              {group.mods.map((mod) => (
                <article class:list={["card", { modsCardMain: group.id === "farm-and-charm" && mod.title === "Farm & Charm" }]} data-search={`${mod.title} ${mod.description} ${(mod.tags ?? []).join(" ")}`.toLowerCase()}>
                  <div class="cardContent">
                    {group.id === "farm-and-charm" ? (
                      mod.title === "Farm & Charm" ? (
                        <span class="modsCardBadge">Core Mod</span>
                      ) : (
                        <span class="modsCardBadge modsCardBadgeAddon">Addon</span>
                      )
                    ) : null}
                    <img class="cardLogo" src={mod.logo} alt={mod.title} loading="lazy" />
                    <h3>{mod.title}</h3>
                    <p>{mod.description}</p>
                  </div>

                  <div class="cardAction">
                    {mod.wiki ? (
                      <a class="btn btnPrimary" href={mod.wiki}>
                        View Wiki
                      </a>
                    ) : null}

                    {mod.source ? (
                      <a class="btn btnSecondary" href={mod.source} target="_blank" rel="noopener">
                        Source Code
                      </a>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      ))}

      <div id="modsEmpty" class="modsEmpty" style="display: none;">
        No mods match your search.
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    const input = document.getElementById("modsSearchInput")
    const meta = document.getElementById("modsSearchMeta")
    const empty = document.getElementById("modsEmpty")
    const groups = Array.from(document.querySelectorAll(".modsGroup"))
    const total = document.querySelectorAll(".modsGroup [data-search]").length

    const update = () => {
      const q = (input.value || "").trim().toLowerCase()
      let visible = 0

      for (const group of groups) {
        const cards = Array.from(group.querySelectorAll("[data-search]"))
        let groupVisible = 0

        for (const card of cards) {
          const show = q.length === 0 || (card.getAttribute("data-search") || "").includes(q)
          card.style.display = show ? "" : "none"
          if (show) groupVisible++
        }

        group.style.display = groupVisible === 0 ? "none" : ""
        visible += groupVisible
      }

      meta.textContent = q.length === 0 ? `${total} mods` : `${visible} of ${total}`
      empty.style.display = visible === 0 ? "" : "none"
    }

    input.addEventListener("input", update)
    update()
  </script>
</SiteLayout>
